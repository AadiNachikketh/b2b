# GEMINI_API_KEY: Required for Gemini AI API calls in the server-side AI Inquiry Assistant (/api/chatbot).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The canonical public URL where this applet is hosted.
# Used for sitemap.xml, robots.txt, and canonical link generation.
APP_URL="MY_APP_URL"

# OPTIONAL EXTERNAL INTEGRATIONS (Graceful Fallbacks Enabled When Unset):
# STRIPE_SECRET_KEY: Optional Stripe API secret for live automated subscription billing charges.
STRIPE_SECRET_KEY=""

# SMTP_TRANSACTIONAL_API_KEY: Optional transactional email provider key for instant lead notifications.
SMTP_TRANSACTIONAL_API_KEY=""

# PAGESPEED_API_KEY: Optional Google PageSpeed Insights API key for extended lab/field CWV checks.
PAGESPEED_API_KEY=""

# GA4_MEASUREMENT_ID: Optional Google Analytics 4 Measurement ID.
GA4_MEASUREMENT_ID=""
